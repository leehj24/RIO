{
  "version": "1.1.0",
  "default_provider": "nvidia_nemotron",
  "provider_config": "providers/nvidia_nemotron.md",
  "direct_order_execution": false,
  "model_groups": {
    "evidence_analysis": {
      "model_env": "NVIDIA_SUPER_MODEL",
      "purpose": "statistics, fact, subjectivity, fundamental, news, sentiment, and technical evidence reports"
    },
    "debate_risk": {
      "model_env": "NVIDIA_NEMOTRON_MODEL",
      "purpose": "reasoning, Bull/Bear debate, trade proposal, and risk review"
    },
    "final_comparison": {
      "model_env": "NVIDIA_FINAL_MODEL",
      "purpose": "independent comparison of analysis, debate, and risk reports before the Python gate"
    }
  },
  "shared_prompts": [
    "shared/decision_contract.md",
    "shared/source_policy.md",
    "shared/audit_reproducibility.md",
    "shared/execution_boundary.md"
  ],
  "pipelines": {
    "live_event_research": [
      "live_trader",
      "live_risk_manager",
      "live_semantic_risk_filter",
      "live_portfolio_manager"
    ],
    "event_research": [
      "statistics_analyst",
      "fact_analyst",
      "subjectivity_analyst",
      "fundamental_analyst",
      "news_analyst",
      "sentiment_analyst",
      "technical_vision_analyst",
      "fact_reasoner",
      "subjectivity_reasoner",
      "bull_researcher",
      "bear_researcher",
      "debate_moderator",
      "trader",
      "risk_aggressive",
      "risk_neutral",
      "risk_conservative",
      "risk_manager",
      "semantic_risk_filter",
      "portfolio_manager"
    ],
    "post_decision": [
      "reflection",
      "memory_curator"
    ],
    "offline_experiments": [
      "simulation_designer",
      "distillation_teacher",
      "latency_optimizer"
    ]
  },
  "agents": [
    {"id": "statistics_analyst", "path": "agents/statistics_analyst.md", "stage": "analysis", "output_schema": "statistics_report"},
    {"id": "fact_analyst", "path": "agents/fact_analyst.md", "stage": "analysis", "output_schema": "fact_report"},
    {"id": "subjectivity_analyst", "path": "agents/subjectivity_analyst.md", "stage": "analysis", "output_schema": "subjectivity_report"},
    {"id": "fundamental_analyst", "path": "agents/fundamental_analyst.md", "stage": "analysis", "output_schema": "analysis_report"},
    {"id": "news_analyst", "path": "agents/news_analyst.md", "stage": "analysis", "output_schema": "analysis_report"},
    {"id": "sentiment_analyst", "path": "agents/sentiment_analyst.md", "stage": "analysis", "output_schema": "analysis_report"},
    {"id": "technical_vision_analyst", "path": "agents/technical_vision_analyst.md", "stage": "analysis", "output_schema": "analysis_report"},
    {"id": "fact_reasoner", "path": "agents/fact_reasoner.md", "stage": "reasoning", "output_schema": "reasoning_report"},
    {"id": "subjectivity_reasoner", "path": "agents/subjectivity_reasoner.md", "stage": "reasoning", "output_schema": "reasoning_report"},
    {"id": "bull_researcher", "path": "agents/bull_researcher.md", "stage": "debate", "output_schema": "debate_report"},
    {"id": "bear_researcher", "path": "agents/bear_researcher.md", "stage": "debate", "output_schema": "debate_report"},
    {"id": "debate_moderator", "path": "agents/debate_moderator.md", "stage": "debate", "output_schema": "debate_report"},
    {"id": "trader", "path": "agents/trader.md", "stage": "proposal", "output_schema": "trade_proposal"},
    {"id": "risk_aggressive", "path": "agents/risk_aggressive.md", "stage": "risk", "output_schema": "risk_review"},
    {"id": "risk_neutral", "path": "agents/risk_neutral.md", "stage": "risk", "output_schema": "risk_review"},
    {"id": "risk_conservative", "path": "agents/risk_conservative.md", "stage": "risk", "output_schema": "risk_review"},
    {"id": "risk_manager", "path": "agents/risk_manager.md", "stage": "risk", "output_schema": "risk_review"},
    {"id": "semantic_risk_filter", "path": "agents/semantic_risk_filter.md", "stage": "risk", "output_schema": "semantic_risk_report"},
    {"id": "portfolio_manager", "path": "agents/portfolio_manager.md", "stage": "approval", "output_schema": "manager_decision"},
    {"id": "live_trader", "path": "agents/live_trader.md", "stage": "proposal", "output_schema": "trade_proposal", "depends_on": []},
    {"id": "live_risk_manager", "path": "agents/live_risk_manager.md", "stage": "risk", "output_schema": "semantic_risk_report", "depends_on": ["live_trader"]},
    {"id": "live_semantic_risk_filter", "path": "agents/live_semantic_risk_filter.md", "stage": "risk", "output_schema": "semantic_risk_report", "depends_on": ["live_trader", "live_risk_manager"]},
    {"id": "live_portfolio_manager", "path": "agents/live_portfolio_manager.md", "stage": "approval", "output_schema": "manager_decision", "depends_on": ["live_trader", "live_risk_manager", "live_semantic_risk_filter"]},
    {"id": "reflection", "path": "agents/reflection.md", "stage": "learning", "output_schema": "reflection_report"},
    {"id": "memory_curator", "path": "agents/memory_curator.md", "stage": "learning", "output_schema": "memory_note"},
    {"id": "simulation_designer", "path": "agents/simulation_designer.md", "stage": "offline", "output_schema": "simulation_scenario"},
    {"id": "distillation_teacher", "path": "agents/distillation_teacher.md", "stage": "offline", "output_schema": "distillation_plan"},
    {"id": "latency_optimizer", "path": "agents/latency_optimizer.md", "stage": "offline", "output_schema": "optimization_plan"}
  ]
}
